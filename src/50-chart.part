
// ---------- まとめの図（ドットプロット）と表 ----------
const SVGNS = "http://www.w3.org/2000/svg";
function svgEl(tag, attrs, parent) {
  const e = document.createElementNS(SVGNS, tag);
  for (const k in attrs) e.setAttribute(k, attrs[k]);
  if (parent) parent.appendChild(e);
  return e;
}
function shapePath(shape, x, y, r) {
  switch (shape) {
    case "square": return `M${x - r * .88},${y - r * .88}h${r * 1.76}v${r * 1.76}h${-r * 1.76}z`;
    case "diamond": return `M${x},${y - r * 1.2}L${x + r * 1.2},${y}L${x},${y + r * 1.2}L${x - r * 1.2},${y}z`;
    case "tri": return `M${x},${y - r * 1.2}L${x + r * 1.1},${y + r * .8}L${x - r * 1.1},${y + r * .8}z`;
    case "tridown": return `M${x},${y + r * 1.2}L${x + r * 1.1},${y - r * .8}L${x - r * 1.1},${y - r * .8}z`;
    default: return `M${x - r},${y}a${r},${r} 0 1,0 ${2 * r},0a${r},${r} 0 1,0 ${-2 * r},0`;
  }
}

function summaryData() {
  const rows = BENCH.map(b => {
    const v = {};
    for (const L of LANGS) { const r = pick(b.id, L.id, S.metric, S.plain); if (r) v[L.id] = r[S.metric]; }
    const best = Math.min(...Object.values(v));
    const ratio = {}; for (const k in v) ratio[k] = v[k] / best;
    return { id: b.id, group: b.group, secs: v, ratio };
  });
  const gm = { id: "幾何平均", group: "10種類", secs: {}, ratio: {}, n: {} };
  for (const L of LANGS) {
    const xs = rows.map(r => r.ratio[L.id]).filter(x => x);
    gm.ratio[L.id] = Math.exp(xs.reduce((a, x) => a + Math.log(x), 0) / xs.length);
    gm.n[L.id] = xs.length;
  }
  return [gm, ...rows];
}

function drawLegend() {
  const lg = document.getElementById("legend"); lg.textContent = "";
  for (const L of LANGS) {
    const s = document.createElement("span");
    const svg = svgEl("svg", { width: 14, height: 14, viewBox: "0 0 14 14", "aria-hidden": "true" });
    svgEl("path", { d: shapePath(L.shape, 7, 7, 5), fill: `var(${L.css})` }, svg);
    s.appendChild(svg); s.append(L.name + "（" + L.impl + "）");
    lg.appendChild(s);
  }
}

function drawPlot() {
  const data = summaryData();
  const svg = document.getElementById("dotplot"); svg.textContent = "";
  const W = svg.parentElement.clientWidth - 24, narrow = W < 560;
  const left = narrow ? 112 : 160, right = 16, top = 26, rowH = 36, H = top + rowH * data.length + 6;
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`); svg.setAttribute("height", H);
  const maxR = Math.max(...data.flatMap(d => Object.values(d.ratio)));
  const ticks = [1, 2, 5, 10, 20, 50, 100, 200, 500, 1000].filter(t => t <= maxR * 1.6);
  const hi = Math.max(ticks[ticks.length - 1], maxR * 1.15);
  const x = v => left + (W - left - right) * Math.log(v) / Math.log(hi);
  for (const t of ticks) {
    svgEl("line", { x1: x(t), x2: x(t), y1: top - 4, y2: H - 4, class: t === 1 ? "base" : "grid" }, svg);
    if (narrow && ![1, 10, 100, 1000].includes(t)) continue;   // 狭い画面では目盛の数字を減らす
    const tx = svgEl("text", { x: x(t), y: top - 10, "text-anchor": "middle", class: "tabnum" }, svg);
    tx.textContent = t + "倍";
  }
  data.forEach((d, i) => {
    const y0 = top + i * rowH, cy = y0 + rowH / 2;
    const g = svgEl("g", {}, svg);
    const hit = svgEl("rect", { x: 0, y: y0, width: W, height: rowH, rx: 6, class: "rowhit",
      tabindex: 0, role: "button", "aria-label": rowLabel(d) }, g);
    if (i === 0) svgEl("line", { x1: 0, x2: W, y1: y0 + rowH, y2: y0 + rowH, class: "grid" }, g);
    const lab = svgEl("text", { x: 4, y: cy - 2, class: "rlabel" }, g);
    lab.textContent = narrow ? (SHORT[d.id] || d.id) : d.id;
    const gl = svgEl("text", { x: 4, y: cy + 13, class: "glabel" }, g); gl.textContent = d.group;
    if (d.id !== S.bench && i > 0) lab.setAttribute("font-weight", "400"); else if (i > 0) lab.setAttribute("font-weight", "700");
    LANGS.forEach((L, j) => {
      const r = d.ratio[L.id]; if (!r) return;
      const yy = cy + (j - 2) * 4;
      svgEl("path", { d: shapePath(L.shape, x(r), yy, 5), fill: `var(${L.css})`, stroke: "var(--surface)", "stroke-width": 2,
        "pointer-events": "none" }, g);
    });
    const show = e => showTip(d, e), hide = () => { tip.style.display = "none"; };
    hit.addEventListener("pointermove", show); hit.addEventListener("pointerleave", hide);
    hit.addEventListener("focus", e => showTip(d, e)); hit.addEventListener("blur", hide);
    if (i > 0) {
      const go = () => { selectBench(d.id); document.getElementById("sim").scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" }); };
      hit.addEventListener("click", go);
      hit.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); go(); } });
    } else hit.style.cursor = "default";
  });
  drawTable(data);
}

const SHORT = { "reverse-complement": "rev-comp", "fannkuch-redux": "fannkuch", "spectral-norm": "spectral" };
function rowLabel(d) {
  return d.id + ": " + LANGS.filter(L => d.ratio[L.id]).map(L => `${L.name} ${fmtX(d.ratio[L.id])}倍`).join("、");
}

const tip = document.getElementById("tip");
function showTip(d, e) {
  tip.textContent = "";
  const h = document.createElement("div"); h.className = "h";
  h.textContent = d.id === "幾何平均" ? "10種類の幾何平均（最速との比）" : d.id; tip.appendChild(h);
  if (d.n) {
    const few = LANGS.filter(L => d.n[L.id] < BENCH.length);
    if (few.length) { const m = document.createElement("div"); m.className = "m";
      m.textContent = few.map(L => `${L.name} は ${d.n[L.id]} 種類で計算`).join("、"); tip.appendChild(m); }
  }
  LANGS.filter(L => d.ratio[L.id]).sort((a, b) => d.ratio[a.id] - d.ratio[b.id]).forEach(L => {
    const r = document.createElement("div"); r.className = "r";
    const k = document.createElement("i"); k.style.background = `var(${L.css})`;
    const n = document.createElement("span"); n.textContent = L.name;
    const v = document.createElement("b");
    v.textContent = (d.secs[L.id] ? fmtSec(d.secs[L.id]) + "・" : "") + fmtX(d.ratio[L.id]) + "倍";
    r.append(k, n, v); tip.appendChild(r);
  });
  tip.style.display = "block";
  let px, py;
  if (e.clientX != null && e.type !== "focus") { px = e.clientX; py = e.clientY; }
  else { const b = e.target.getBoundingClientRect(); px = b.left + b.width * 0.6; py = b.top + b.height; }
  const tw = tip.offsetWidth, th = tip.offsetHeight;
  tip.style.left = Math.max(8, Math.min(innerWidth - tw - 8, px + 14)) + "px";
  tip.style.top = Math.max(8, Math.min(innerHeight - th - 8, py + 14)) + "px";
}

function drawTable(data) {
  const t = document.getElementById("table"); t.textContent = "";
  const hr = t.insertRow(); const th0 = document.createElement("th"); th0.textContent = "ベンチマーク"; hr.appendChild(th0);
  for (const L of LANGS) { const th = document.createElement("th"); th.textContent = L.name; hr.appendChild(th); }
  for (const d of data) {
    const tr = t.insertRow(); tr.insertCell().textContent = d.id;
    for (const L of LANGS) {
      const r = d.ratio[L.id];
      tr.insertCell().textContent = !r ? "—" : (d.secs[L.id] ? `${fmtSec(d.secs[L.id])}（${fmtX(r)}倍）` : `${fmtX(r)}倍`);
    }
  }
}

// ---------- 操作 ----------
function buildChips() {
  const box = document.getElementById("chips");
  for (const b of BENCH) {
    const c = document.createElement("button"); c.className = "chip"; c.dataset.id = b.id;
    c.textContent = b.id; c.setAttribute("aria-pressed", b.id === S.bench);
    c.addEventListener("click", () => selectBench(b.id));
    box.appendChild(c);
  }
}
function selectBench(id) {
  S.bench = id;
  document.querySelectorAll(".chip").forEach(c => c.setAttribute("aria-pressed", c.dataset.id === id));
  buildLanes(); drawPlot(); if (!reduceMotion) setRunning(true); needsDraw = true;
}
document.querySelectorAll(".seg").forEach(seg => {
  seg.addEventListener("click", e => {
    const b = e.target.closest("button"); if (!b) return;
    seg.querySelectorAll("button").forEach(x => x.setAttribute("aria-pressed", x === b));
    const k = seg.dataset.key, v = b.dataset.v;
    if (k === "speed") { S.speed = parseFloat(v); }
    else {
      if (k === "plain") S.plain = v === "1"; else if (k === "metric") S.metric = v; else S.mode = v;
      buildLanes(); drawPlot(); if (!reduceMotion) setRunning(true);
    }
    needsDraw = true;
  });
});
document.getElementById("play").addEventListener("click", () => {
  const allDone = S.mode === "race" && S.finishCount > 0 && S.finishCount === S.lanes.filter(l => l.secs).length;
  if (allDone) resetClock();
  setRunning(!S.running || allDone);
});
document.getElementById("reset").addEventListener("click", () => { resetClock(); needsDraw = true; });
let rz; addEventListener("resize", () => { clearTimeout(rz); rz = setTimeout(() => { sizeCanvases(); drawPlot(); needsDraw = true; }, 150); });
matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { readColors(); FRACTAL.clear(); drawPlot(); needsDraw = true; });

readColors(); buildChips(); drawLegend(); buildLanes(); drawPlot(); setRunning(S.running);
requestAnimationFrame(loop);
